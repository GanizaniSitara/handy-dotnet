<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Handy</RootNamespace>
    <AssemblyName>Handy</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <PublishSingleFile Condition="'$(PublishSingleFile)' == ''">false</PublishSingleFile>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- VersionPrefix is defined in the repo-root Directory.Build.props. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- The DirectML build is the CPU build plus Windows' own GPU layer: any
         DirectX 12 adapter, nothing extra to install. On a machine without one
         it behaves exactly like the CPU package. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.20.1" />
    <PackageReference Include="Microsoft.AI.DirectML" Version="1.15.2" GeneratePathProperty="true" />
    <PackageReference Include="Whisper.net" Version="1.9.0" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\help.md" Link="docs\help.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\domain-terms.md" Link="docs\domain-terms.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- Microsoft.AI.DirectML only copies its DLL for x64-platform builds; this
         project is AnyCPU. Without the redistributable beside onnxruntime.dll,
         Windows loads the ancient System32 DirectML.dll and every adapter
         reports "feature level not supported". -->
    <None Include="$(PkgMicrosoft_AI_DirectML)\bin\x64-win\DirectML.dll" Link="DirectML.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- Whisper.net.Runtime stages its native whisper.cpp DLLs for every Windows
       architecture regardless of the publish RID, so a win-x64 publish ships
       win-arm64 and win-x86 copies it can never load. Drop them. -->
  <Target Name="TrimForeignRuntimes" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <ForeignRuntimeFile Include="$(PublishDir)runtimes\**\*.*"
                          Exclude="$(PublishDir)runtimes\$(RuntimeIdentifier)\**\*.*" />
    </ItemGroup>
    <Delete Files="@(ForeignRuntimeFile)" />
    <RemoveDir Directories="@(ForeignRuntimeFile->'%(RootDir)%(Directory)')" />
  </Target>

</Project>
